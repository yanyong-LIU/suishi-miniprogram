@import "../../styles/icons.wxss";

.dlgwrap {
  position: fixed;
  inset: 0;
  z-index: 8000;
}
.dlgscrim {
  position: absolute;
  inset: 0;
  background: rgba(38, 36, 31, .4);
  animation: dlgfade .16s ease-out;
}
@keyframes dlgfade {
  from { opacity: 0 } to { opacity: 1 }
}

.dlg {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: calc(100% - 112rpx);
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 44rpx 40rpx 24rpx;
  box-shadow: 0 36rpx 100rpx rgba(30, 27, 22, .25);
  animation: dlgin .22s cubic-bezier(.32, .72, 0, 1);
}
@keyframes dlgin {
  from { opacity: 0; transform: translate(-50%, -48%) scale(.96) }
  to { opacity: 1; transform: translate(-50%, -50%) scale(1) }
}

.dt { font-size: 36rpx; font-weight: 500; text-align: center; color: #26241F; }
.dd { font-size: 26rpx; color: #6E6A5F; text-align: center; margin-top: 16rpx; line-height: 1.7; }

.dlgsw {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0 8rpx;
  position: relative;
}
.dlgsw::before {
  content: '';
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 1rpx;
  background: #E5E0D4;
}
.dswi { width: 36rpx; height: 36rpx; }
.dswm { font-size: 30rpx; color: #26241F; }
.dsws { font-size: 24rpx; color: #A19B8D; margin-top: 4rpx; }

.dacts { display: flex; gap: 20rpx; margin-top: 36rpx; }
.dacts .btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: #3D4E68;
  color: #fff;
}
.dacts .btn:active { background: #2B384C; }
.dacts .btn.danger { background: #C4453A; }

.cancel {
  display: block;
  text-align: center;
  font-size: 30rpx;
  color: #A19B8D;
  padding: 24rpx 0 8rpx;
}

.sw {
  position: relative;
  flex: none;
  width: 76rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #D9D4C7;
  transition: background .2s;
}
.sw .knob {
  position: absolute;
  top: 4rpx; left: 4rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: #fff;
  transition: transform .2s cubic-bezier(.32, .72, 0, 1);
}
.sw.on { background: #3D4E68; }
.sw.on .knob { transform: translateX(32rpx); }

.flex1 { flex: 1; min-width: 0; }
