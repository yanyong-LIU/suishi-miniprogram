@import "../../styles/icons.wxss";

.wpwrap { position: fixed; inset: 0; z-index: 8000; }
.wpscrim {
  position: absolute;
  inset: 0;
  background: rgba(38, 36, 31, .4);
  animation: wpfade .16s ease-out;
}
@keyframes wpfade { from { opacity: 0 } to { opacity: 1 } }

.wpsheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  animation: wpin .24s cubic-bezier(.32, .72, 0, 1);
  padding-bottom: env(safe-area-inset-bottom);
}
@keyframes wpin { from { transform: translateY(101%) } to { transform: translateY(0) } }

.wpgrab { padding: 16rpx 0 8rpx; display: flex; justify-content: center; }
.wpgrabi { width: 72rpx; height: 8rpx; border-radius: 999rpx; background: #E5E0D4; }

.wpsnav {
  display: flex;
  align-items: center;
  padding: 4rpx 16rpx 12rpx;
  min-height: 80rpx;
}
.wpcancel { width: 128rpx; font-size: 30rpx; color: #6E6A5F; padding: 16rpx; }
.wptitle {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
  color: #26241F;
}
.wpok { width: 128rpx; text-align: right; font-size: 30rpx; color: #3D4E68; font-weight: 500; padding: 16rpx; }

.wpchips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 12rpx 32rpx 8rpx;
}
.wpchips .chip {
  flex: none;
  height: 68rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E5E0D4;
  background: #FFFFFF;
  color: #6E6A5F;
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
}
.wpchips .chip.on {
  background: #E8EDF5;
  color: #3D4E68;
  border-color: transparent;
  font-weight: 500;
}

/* ── 滚轮 ── */
.wheels {
  position: relative;
  margin: 8rpx 32rpx 4rpx;
}
.wpview {
  width: 100%;
  height: 340rpx;
}
/* picker-view 的选中指示条：对应设计里的高亮带
   注意这里不用伪元素，picker-view 会在指示层上直接挂本 class */
.wpind {
  height: 96rpx;
  border-top: 1rpx solid #E5E0D4;
  border-bottom: 1rpx solid #E5E0D4;
}
.wit {
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #26241F;
  line-height: 1.15;
}
.wit1 { font-size: 32rpx; color: #26241F; }
.wit2 { font-size: 24rpx; color: #A19B8D; margin-top: 2rpx; }
.witc { font-size: 36rpx; color: #26241F; }
.alldaytxt { font-size: 30rpx; color: #6E6A5F; }

.wpcolon {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 36rpx;
  font-weight: 500;
  color: #26241F;
  pointer-events: none;
}

.wphint {
  text-align: right;
  padding: 12rpx 36rpx 0;
  font-size: 24rpx;
  color: #A19B8D;
  min-height: 40rpx;
}
.wplock {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx 0;
  font-size: 26rpx;
  color: #A19B8D;
}
.wplocki { width: 30rpx; height: 30rpx; }
